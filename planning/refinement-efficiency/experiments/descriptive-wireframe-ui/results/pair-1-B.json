  "reviewRounds": [
    {
      "stage": "structural-review",
      "round": 1,
      "verdict": "revise",
      "findings": [
        {
          "id": "B1-SR-01",
          "category": "coverage",
          "blocking": true,
          "route": "layout",
          "title": "Specify the shared preview scope and its visible outcome",
          "sourceRequirementRefs": [
            "product-requirements.json#precise-selection",
            "product-requirements.json#scrub-and-follow",
            "scope-surfaces.json#timeline-behavior",
            "actions.json#play-preview.canonicalInteraction.description",
            "feedback.json#play-preview-result"
          ],
          "scenarioRefs": [
            "s01-composition-base",
            "s02-inclusive-range",
            "s03-object-trim",
            "s04-independent-zoom",
            "s06-group-properties"
          ],
          "evidence": "ED-PLAYER describes one composed-output player resolving the timeline frame; TL-RANGE defines the fixed Play/Stop control and range selection. Neither shared region nor the selected states specifies that Play uses the active video with no selection, the complete composition within an inclusive range, or the earliest-Start/latest-End composed span for whole objects including gaps and other tracks. ED-CONTEXT identifies selection but does not state playback scope. The cited play-preview/stop-preview action IDs do not supply that missing handoff description.",
          "impact": "The UI handoff can portray object selection as isolated-clip playback or omit the inclusive preview extent even though the frozen source requires composition playback across that span. It also leaves the visible stopped position/follow state unspecified for the shared transport.",
          "specificCorrection": "Extend ED-PLAYER/TL-RANGE and the shared transport description with the three source-defined preview scopes, inclusive End, and a visible association between current selection extent and playback scope. State that Stop retains the resolved player/playhead frame and that playback follows until intentional timeline pan. Preserve current geometry freedom and the existing 14-state set; no extra state or new policy is required."
        },
        {
          "id": "B1-SR-02",
          "category": "structural",
          "blocking": true,
          "route": "layout",
          "title": "Make the accepted commit-freeze control availability explicit",
          "sourceRequirementRefs": [
            "scope-surfaces.json#video-saving",
            "interaction-frames.json#video-saving-view.purpose",
            "interaction-frames.json#video-saving-view-video-range.purpose",
            "actions.json#play-preview",
            "actions.json#stop-preview",
            "actions.json#scrub",
            "actions.json#step-frame",
            "actions.json#zoom-player-in",
            "actions.json#zoom-player-out",
            "actions.json#fit-player",
            "actions.json#pan-player",
            "actions.json#zoom-timeline",
            "actions.json#pan-timeline"
          ],
          "scenarioRefs": [
            "s11-video-saving-busy",
            "s11-video-save-failure",
            "s04-independent-zoom"
          ],
          "evidence": "The busy paragraph says player/timeline inspection zoom and pan 'may remain usable'. Its explicit disable list does not identify Play/Stop, scrubbing or frame stepping, although the same paragraph says the player remains stopped at frame 750. The accepted video-saving frame requires inspection-only zoom/pan to remain available and its range region disables transport changes; source action applicability excludes the transport/scrub/step actions from video-saving while including the inspection controls.",
          "impact": "UI can follow this description yet disable accepted inspection controls or leave controls active that change the captured stopped frame during the save. This is an interaction-state distinction rather than a cosmetic styling choice.",
          "specificCorrection": "In the shared commit-freeze description and s11-video-saving-busy, explicitly keep player Zoom In/Zoom Out/Fit/pan and timeline zoom/pan available subject to their ordinary limits, and explicitly disable Play/Stop, scrubbing and frame stepping during the actual commit. Keep the captured preview/frame and selection/insertion intact; restore eligible controls only after the actual result. Do not add percentage progress, cancellation or queued commands."
        }
      ],
