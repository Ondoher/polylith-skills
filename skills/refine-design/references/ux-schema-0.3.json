{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:codex:refine-design:ux-schema:0.3",
	"title": "UX Interaction Architecture 0.3",
	"description": "Product-neutral contract for the UX-to-UI interaction architecture handoff.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"id",
		"title",
		"revision",
		"status",
		"assessment",
		"sources",
		"product",
		"application",
		"features",
		"useCases",
		"surfaces",
		"components",
		"actions",
		"interactionFrames",
		"patternResearch",
		"pruningReview",
		"openQuestions",
		"productModelBinding",
		"useCaseRelations",
		"flowNodes",
		"flowEdges",
		"states",
		"feedback",
		"recoveryPaths",
		"productRealizations",
		"traceGaps"
	],
	"properties": {
		"schemaVersion": {
			"const": "0.3"
		},
		"id": {
			"$ref": "#/$defs/stableId"
		},
		"title": {
			"$ref": "#/$defs/nonEmptyText"
		},
		"revision": {
			"$ref": "#/$defs/nonEmptyText"
		},
		"status": {
			"$ref": "#/$defs/status"
		},
		"assessment": {
			"$ref": "#/$defs/assessment"
		},
		"sources": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/source"
			}
		},
		"product": {
			"$ref": "#/$defs/product"
		},
		"supportingDocuments": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/supportingDocument"
			}
		},
		"application": {
			"$ref": "#/$defs/application"
		},
		"features": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/feature"
			}
		},
		"useCases": {
			"type": "array",
			"contains": {
				"type": "object",
				"required": ["taskPriority"],
				"properties": {
					"taskPriority": {
						"const": "primary"
					}
				}
			},
			"minContains": 1,
			"items": {
				"$ref": "#/$defs/useCase"
			}
		},
		"surfaces": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/surface"
			}
		},
		"components": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/component"
			}
		},
		"actions": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/action"
			}
		},
		"interactionFrames": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/interactionFrame"
			}
		},
		"patternResearch": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/patternResearch"
			}
		},
		"pruningReview": {
			"$ref": "#/$defs/pruningReview"
		},
		"openQuestions": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/openQuestion"
			}
		},
		"productModelBinding": {
			"$ref": "#/$defs/productModelBinding"
		},
		"useCaseRelations": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/useCaseRelation"
			}
		},
		"flowNodes": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/flowNode"
			}
		},
		"flowEdges": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/flowEdge"
			}
		},
		"states": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/semanticState"
			}
		},
		"feedback": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/semanticFeedback"
			}
		},
		"recoveryPaths": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/semanticRecovery"
			}
		},
		"productRealizations": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/productRealization"
			}
		},
		"traceGaps": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/traceGap"
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"useCases": {
						"contains": {
							"type": "object",
							"required": ["taskPriority", "status"],
							"properties": {
								"taskPriority": {
									"const": "primary"
								},
								"status": {
									"enum": ["accepted", "locked"]
								}
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"pruningReview": {
						"type": "object",
						"required": ["status"],
						"properties": {
							"status": {
								"enum": ["accepted", "locked"]
							}
						}
					}
				}
			}
		}
	],
	"x-semanticRules": [
		"All source, model, UX, and graph references resolve by stable typed identity and exact product-model binding.",
		"A resolved use case has a reachable entry flow node, explicit ordered canonical steps, and explicit branches, recovery, state, feedback, and shared-component invocation edges.",
		"Every independently meaningful UX record has status and source provenance; no document or implementation hierarchy is encoded.",
		"Product realization relations resolve to current product goals, requirements, rules, or gaps of allowed kinds; missing links are recorded as trace gaps.",
		"Dialog frames remain the one dialog authority; UI scenes bind exact UX frames, states, and depicted semantic elements.",
		"Research source URLs use public HTTPS without user information. Hosts are not private, loopback, link-local, IPv4-compatible private/loopback, NAT64 private/loopback, single-label, local, or internal. Recursively decoded URL paths, queries, and fragments and all other durable research strings contain no bearer/vendor tokens, normalized credential-key assignments, secret query parameters, file URLs, or private absolute filesystem paths."
	],
	"$defs": {
		"nonEmptyText": {
			"type": "string",
			"pattern": "\\S"
		},
		"repositoryRelativePath": {
			"description": "A narrow unencoded ASCII repository-relative document path with one optional local fragment.",
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*(?:#[A-Za-z][A-Za-z0-9_.:-]*)?$"
		},
		"stableId": {
			"description": "A nonempty identifier that remains stable across revisions of this UX document.",
			"type": "string",
			"pattern": "\\S"
		},
		"status": {
			"enum": ["default", "proposed", "accepted", "locked", "unresolved"]
		},
		"resolvedStatus": {
			"enum": ["accepted", "locked"]
		},
		"priority": {
			"enum": ["primary", "secondary", "contextual", "supporting"]
		},
		"persistence": {
			"enum": ["persistent", "state-bound", "transient"]
		},
		"idList": {
			"type": "array",
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/stableId"
			}
		},
		"referenceList": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/stableId"
			}
		},
		"textList": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/nonEmptyText"
			}
		},
		"uniqueTextList": {
			"type": "array",
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/nonEmptyText"
			}
		},
		"assessment": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "description"],
			"properties": {
				"kind": {
					"enum": ["ux-planner-assessment", "parent-assessment"]
				},
				"description": {
					"$ref": "#/$defs/nonEmptyText"
				}
			}
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "path", "revision", "kind"],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"path": {
					"$ref": "#/$defs/repositoryRelativePath"
				},
				"revision": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"kind": {
					"$ref": "#/$defs/nonEmptyText"
				}
			}
		},
		"product": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "overview", "users"],
			"properties": {
				"name": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"overview": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"users": {
					"$ref": "#/$defs/textList"
				}
			}
		},
		"supportingDocument": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "path", "description"],
			"properties": {
				"label": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"path": {
					"$ref": "#/$defs/repositoryRelativePath"
				},
				"description": {
					"$ref": "#/$defs/nonEmptyText"
				}
			}
		},
		"application": {
			"type": "object",
			"additionalProperties": false,
			"required": ["summary", "shell", "areas"],
			"properties": {
				"summary": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"shell": {
					"$ref": "#/$defs/shell"
				},
				"areas": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/area"
					}
				}
			}
		},
		"shell": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "description", "status"],
			"properties": {
				"kind": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"description": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"navigation": {
					"$ref": "#/$defs/navigation"
				},
				"regions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/shellRegion"
					}
				}
			}
		},
		"navigation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["pattern", "description"],
			"properties": {
				"pattern": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"description": {
					"$ref": "#/$defs/nonEmptyText"
				}
			}
		},
		"shellRegion": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "kind", "purpose", "persistence", "order"],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"name": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"kind": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"purpose": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"persistence": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"order": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"area": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "purpose", "status", "surfaceRefs"],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"name": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"purpose": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"surfaceRefs": {
					"$ref": "#/$defs/idList"
				}
			}
		},
		"feature": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "purpose", "status", "sourceRefs", "surfaceRefs", "useCaseRefs", "questionRefs"],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"name": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"purpose": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"sourceRefs": {
					"$ref": "#/$defs/idList"
				},
				"surfaceRefs": {
					"$ref": "#/$defs/idList"
				},
				"useCaseRefs": {
					"$ref": "#/$defs/idList"
				},
				"questionRefs": {
					"$ref": "#/$defs/referenceList"
				}
			}
		},
		"surface": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"kind",
				"purpose",
				"entry",
				"exit",
				"focusIntent",
				"status",
				"areaRef",
				"regions",
				"componentRefs",
				"stateRefs",
				"interactionFrameRefs",
				"questionRefs"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"name": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"kind": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"purpose": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"entry": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"exit": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"focusIntent": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"areaRef": {
					"$ref": "#/$defs/stableId"
				},
				"regions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/surfaceRegion"
					}
				},
				"componentRefs": {
					"$ref": "#/$defs/idList"
				},
				"interactionFrameRefs": {
					"$ref": "#/$defs/idList"
				},
				"questionRefs": {
					"$ref": "#/$defs/referenceList"
				},
				"stateRefs": {
					"$ref": "#/$defs/idList"
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["status"],
						"properties": {
							"status": {
								"$ref": "#/$defs/resolvedStatus"
							}
						}
					},
					"then": {
						"properties": {
							"regions": {
								"minItems": 1
							},
							"interactionFrameRefs": {
								"minItems": 1
							}
						}
					}
				}
			]
		},
		"surfaceRegion": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "purpose", "order", "componentRefs"],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"name": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"purpose": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"order": {
					"type": "integer",
					"minimum": 1
				},
				"componentRefs": {
					"$ref": "#/$defs/idList"
				}
			}
		},
		"component": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"kind",
				"purpose",
				"status",
				"surfaceRefs",
				"questionRefs",
				"capabilities",
				"stateRefs",
				"behaviorNodeRefs"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"name": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"kind": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"purpose": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"surfaceRefs": {
					"$ref": "#/$defs/idList"
				},
				"questionRefs": {
					"$ref": "#/$defs/referenceList"
				},
				"capabilities": {
					"$ref": "#/$defs/textList"
				},
				"stateRefs": {
					"$ref": "#/$defs/idList"
				},
				"behaviorNodeRefs": {
					"$ref": "#/$defs/idList"
				},
				"entryBehaviorNodeRef": {
					"$ref": "#/$defs/stableId"
				}
			}
		},
		"patternResearch": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"status",
				"question",
				"trigger",
				"method",
				"reviewedAt",
				"searchQueries",
				"sources",
				"patterns",
				"outcome",
				"selection",
				"rejectedPatterns",
				"limits",
				"verification",
				"taskRefs",
				"actionRefs",
				"frameRefs"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"question": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"trigger": {
					"enum": [
						"unfamiliar-capability",
						"complex-product-interaction",
						"no-established-pattern",
						"conflicting-conventions"
					]
				},
				"method": {
					"enum": ["bounded-online-search", "supplied-sources-verified"]
				},
				"reviewedAt": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"searchQueries": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/nonEmptyText"
					}
				},
				"sources": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/researchSource"
					}
				},
				"patterns": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/researchedPattern"
					}
				},
				"outcome": {
					"enum": ["pattern-selected", "conflicting-patterns-resolved", "no-suitable-precedent"]
				},
				"selection": {
					"$ref": "#/$defs/researchSelection"
				},
				"rejectedPatterns": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/rejectedPattern"
					}
				},
				"limits": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/nonEmptyText"
					}
				},
				"verification": {
					"$ref": "#/$defs/researchVerification"
				},
				"taskRefs": {
					"$ref": "#/$defs/referenceList"
				},
				"actionRefs": {
					"$ref": "#/$defs/referenceList"
				},
				"frameRefs": {
					"$ref": "#/$defs/referenceList"
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["outcome"],
						"properties": {
							"outcome": {
								"const": "no-suitable-precedent"
							}
						}
					},
					"then": {
						"properties": {
							"selection": {
								"required": ["uncertainty"],
								"not": {
									"required": ["patternRef"]
								}
							}
						}
					},
					"else": {
						"properties": {
							"selection": {
								"required": ["patternRef"]
							}
						}
					}
				},
				{
					"if": {
						"required": ["status"],
						"properties": {
							"status": {
								"$ref": "#/$defs/resolvedStatus"
							}
						}
					},
					"then": {
						"properties": {
							"verification": {
								"required": ["status"],
								"properties": {
									"status": {
										"const": "source-checked"
									}
								}
							}
						}
					}
				},
				{
					"anyOf": [
						{
							"properties": {
								"taskRefs": {
									"minItems": 1
								}
							}
						},
						{
							"properties": {
								"actionRefs": {
									"minItems": 1
								}
							}
						},
						{
							"properties": {
								"frameRefs": {
									"minItems": 1
								}
							}
						}
					]
				}
			]
		},
		"researchSource": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "sourceType", "sourceUrl", "accessedAt", "observations"],
			"properties": {
				"id": {
					"$ref": "#/$defs/stableId"
				},
				"title": {
					"$ref": "#/$defs/nonEmptyText"
				},
				"sourceType": {
					"enum": [
						"standard",
						"platform-guidance",
						"official-product-doc",
						"maintained-project-manual",
						"primary-research",
						"original-author-guidance"
					]
				},
				"sourceUrl": {
					"type": "string",
					"format": "uri",
