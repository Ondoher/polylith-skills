							"kind": {
								"enum": ["none", "completion"]
							}
						}
					},
					"then": {
						"not": {
							"anyOf": [
								{
									"required": ["targetRef"]
								},
								{
									"required": ["targetState"]
								}
							]
						}
					}
				},
				{
					"if": {
						"required": ["kind"],
						"properties": {
							"kind": {
								"const": "state"
							}
						}
					},
					"then": {
						"required": ["targetState"],
						"not": {
							"required": ["targetRef"]
						}
					}
				},
				{
					"if": {
						"required": ["kind"],
						"properties": {
							"kind": {
								"const": "frame"
							}
						}
					},
					"then": {
						"required": ["targetRef"],
						"not": {
							"required": ["targetState"]
						}
					}
				},
				{
					"if": {
						"required": ["kind"],
						"properties": {
							"kind": {
								"const": "surface"
							}
						}
					},
					"then": {
						"required": ["targetRef", "targetState"]
					}
				}
			]
		},
