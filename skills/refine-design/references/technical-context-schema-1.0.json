{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://codex.local/refine-design/technical-context-schema-1.0.json",
	"title": "Technical preparation 1.0 and context 2.0",
	"oneOf": [
		{
			"$ref": "#/$defs/technicalContext"
		},
		{
			"$ref": "#/$defs/preparationInput"
		},
		{
			"$ref": "#/$defs/technicalPayload"
		},
		{
			"$ref": "#/$defs/technicalEvidence"
		},
		{
			"$ref": "#/$defs/repositoryBaseline"
		}
	],
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
			"maxLength": 80
		},
		"text": {
			"type": "string",
			"minLength": 1,
			"maxLength": 32768,
			"pattern": "^[^\\u0000]+$"
		},
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"revision": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"owner": {
			"enum": [
				"product",
				"ux",
				"ui",
				"system-architecture",
				"data-model",
				"controller",
				"technical-documentation",
				"implementation-planning",
				"testing",
				"coding"
			]
		},
		"consumer": {
			"enum": [
				"prd",
				"ux",
				"ui",
				"system-architecture",
				"data-model",
				"controller",
				"technical-documentation",
				"implementation-planning",
				"testing",
				"coding"
			]
		},
		"productStatus": {
			"enum": ["accepted", "partial", "locked"]
		},
		"recordStatus": {
			"enum": ["accepted", "locked"]
		},
		"artifactStatus": {
			"enum": ["accepted", "partial", "locked", "superseded"]
		},
		"consumableArtifactStatus": {
			"enum": ["accepted", "partial", "locked"]
		},
		"refs": {
			"type": "array",
			"maxItems": 10000,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/id"
			}
		},
		"recordDependency": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "materialSha256"],
			"properties": {
				"id": {
					"$ref": "#/$defs/id"
				},
				"materialSha256": {
					"$ref": "#/$defs/sha256"
				}
			}
		},
		"artifactDependency": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "revision", "materialSha256"],
			"properties": {
				"id": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"$ref": "#/$defs/revision"
				},
				"materialSha256": {
					"$ref": "#/$defs/sha256"
				}
			}
		},
		"artifactHistory": {
			"oneOf": [
				{
					"properties": {
						"revision": {
							"const": 1
						},
						"status": {
							"enum": ["accepted", "partial", "locked"]
						},
						"change": {
							"properties": {
								"kind": {
									"const": "added"
								},
								"previousRevision": {
									"type": "null"
								},
								"previousMaterialSha256": {
									"type": "null"
								}
							}
						}
					}
				},
				{
					"properties": {
						"revision": {
							"type": "integer",
							"minimum": 2,
							"maximum": 9007199254740991
						},
						"status": {
							"enum": ["accepted", "partial", "locked"]
						},
						"change": {
							"properties": {
								"kind": {
									"const": "unchanged"
								},
								"previousRevision": {
									"$ref": "#/$defs/revision"
								},
								"previousMaterialSha256": {
									"$ref": "#/$defs/sha256"
								}
							}
						}
					}
				},
				{
					"properties": {
						"revision": {
							"type": "integer",
							"minimum": 2,
							"maximum": 9007199254740991
						},
						"status": {
							"enum": ["accepted", "partial", "locked"]
						},
						"change": {
							"properties": {
								"kind": {
									"const": "modified"
								},
								"previousRevision": {
									"$ref": "#/$defs/revision"
								},
								"previousMaterialSha256": {
									"$ref": "#/$defs/sha256"
								}
							}
						}
					}
				},
				{
					"properties": {
						"revision": {
							"type": "integer",
							"minimum": 2,
							"maximum": 9007199254740991
						},
						"status": {
							"const": "superseded"
						},
						"change": {
							"properties": {
								"kind": {
									"const": "superseded"
								},
								"previousRevision": {
									"$ref": "#/$defs/revision"
								},
								"previousMaterialSha256": {
									"$ref": "#/$defs/sha256"
								}
							}
						}
					}
				}
			]
		},
		"artifact": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schemaVersion",
				"kind",
				"id",
				"artifactKind",
				"owner",
				"artifactSchemaVersion",
				"revision",
				"status",
				"consumerDomains",
				"scopeRefs",
				"coverageRefs",
				"gapRefs",
				"lockRefs",
				"recordDependencies",
				"artifactDependencies",
				"producer",
				"resources",
				"payload",
				"materialSha256",
				"change"
			],
			"properties": {
				"schemaVersion": {
					"const": "1.0"
				},
				"kind": {
					"const": "product-artifact"
				},
				"id": {
					"$ref": "#/$defs/id"
				},
				"artifactKind": {
					"$ref": "#/$defs/id"
				},
				"owner": {
					"$ref": "#/$defs/owner"
				},
				"artifactSchemaVersion": {
					"type": "string",
					"pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[a-z0-9.-]+)?$",
					"maxLength": 64
				},
				"revision": {
					"$ref": "#/$defs/revision"
				},
				"status": {
					"$ref": "#/$defs/consumableArtifactStatus"
				},
				"consumerDomains": {
					"type": "array",
					"minItems": 1,
					"maxItems": 10,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/consumer"
					}
				},
				"scopeRefs": {
					"type": "array",
					"minItems": 1,
					"maxItems": 10000,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/id"
					}
				},
				"coverageRefs": {
					"$ref": "#/$defs/refs"
				},
				"gapRefs": {
					"$ref": "#/$defs/refs"
				},
				"lockRefs": {
					"$ref": "#/$defs/refs"
				},
				"recordDependencies": {
					"type": "array",
					"maxItems": 10000,
					"items": {
						"$ref": "#/$defs/recordDependency"
					}
				},
				"artifactDependencies": {
					"type": "array",
					"maxItems": 10000,
					"items": {
						"$ref": "#/$defs/artifactDependency"
					}
				},
				"producer": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "contractVersion", "method"],
					"properties": {
						"id": {
							"$ref": "#/$defs/id"
						},
						"contractVersion": {
							"type": "string",
							"pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[a-z0-9.-]+)?$",
							"maxLength": 64
						},
						"method": {
							"$ref": "#/$defs/id"
						}
					}
				},
				"payload": {},
				"materialSha256": {
					"$ref": "#/$defs/sha256"
				},
				"change": {
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "previousRevision", "previousMaterialSha256"],
					"properties": {
						"kind": {
							"enum": ["added", "unchanged", "modified", "superseded"]
						},
						"previousRevision": {
							"oneOf": [
								{
									"type": "null"
								},
								{
									"$ref": "#/$defs/revision"
								}
							]
						},
						"previousMaterialSha256": {
							"oneOf": [
								{
									"type": "null"
								},
								{
									"$ref": "#/$defs/sha256"
								}
							]
						}
					}
				},
				"resources": {
					"type": "array",
					"maxItems": 10000,
					"items": {
						"$ref": "#/$defs/resourceDescriptor"
					}
				}
			},
			"allOf": [
				{
					"$ref": "#/$defs/artifactHistory"
				}
			]
		},
		"resourceDescriptor": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "logicalPath", "path", "mediaType", "byteLength", "sha256"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
					"maxLength": 80
				},
				"logicalPath": {
					"type": "string",
					"minLength": 1,
					"maxLength": 1024
				},
				"path": {
					"type": "string",
					"pattern": "^artifact-resources/[a-f0-9]{64}\\.(?:png|jpg|webp|svg|html|css|txt|ttf|woff2)$"
				},
				"mediaType": {
					"enum": [
						"image/png",
						"image/jpeg",
						"image/webp",
						"image/svg+xml",
						"text/html",
						"text/css",
						"text/plain",
						"font/ttf",
						"font/woff2"
					]
				},
				"byteLength": {
					"type": "integer",
					"minimum": 1,
					"maximum": 20971520
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			}
		},
		"technicalPayload": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schemaVersion", "evidenceDependencies", "records"],
			"properties": {
				"schemaVersion": {
					"const": "1.0"
				},
				"evidenceDependencies": {
					"type": "array",
					"maxItems": 10000,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "materialSha256"],
						"properties": {
							"id": {
								"$ref": "#/$defs/id"
							},
							"materialSha256": {
								"$ref": "#/$defs/sha256"
							}
						}
					}
				},
				"records": {
					"type": "array",
					"maxItems": 10000,
					"items": {
						"oneOf": [
							{
								"type": "object",
								"additionalProperties": false,
								"required": [
									"id",
									"kind",
									"title",
									"summary",
									"owner",
									"scopeRefs",
									"productRefs",
									"artifactRefs",
									"dependsOn",
									"evidenceRefs",
									"status",
									"details"
								],
								"properties": {
									"id": {
										"$ref": "#/$defs/id"
									},
									"kind": {
										"const": "fact"
									},
									"title": {
										"$ref": "#/$defs/text"
									},
									"summary": {
										"$ref": "#/$defs/text"
									},
									"owner": {
										"$ref": "#/$defs/owner"
									},
									"scopeRefs": {
										"$ref": "#/$defs/refs"
									},
									"productRefs": {
										"$ref": "#/$defs/refs"
									},
									"artifactRefs": {
										"$ref": "#/$defs/refs"
									},
									"dependsOn": {
										"$ref": "#/$defs/refs"
									},
									"evidenceRefs": {
										"$ref": "#/$defs/refs"
									},
									"status": {
										"enum": ["observed"]
									},
									"details": {
										"type": "object",
										"additionalProperties": false,
										"required": ["claim", "limits"],
										"properties": {
											"claim": {
												"$ref": "#/$defs/text"
											},
											"limits": {
												"$ref": "#/$defs/text"
											},
											"discussion": {
												"type": "array",
												"maxItems": 32,
												"items": {
													"$ref": "#/$defs/text"
												}
											}
										}
									}
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": [
									"id",
									"kind",
									"title",
									"summary",
									"owner",
									"scopeRefs",
									"productRefs",
									"artifactRefs",
									"dependsOn",
									"evidenceRefs",
									"status",
									"details"
								],
								"properties": {
									"id": {
										"$ref": "#/$defs/id"
									},
									"kind": {
										"const": "boundary"
									},
									"title": {
										"$ref": "#/$defs/text"
									},
									"summary": {
										"$ref": "#/$defs/text"
									},
									"owner": {
										"$ref": "#/$defs/owner"
									},
									"scopeRefs": {
										"$ref": "#/$defs/refs"
									},
									"productRefs": {
										"$ref": "#/$defs/refs"
									},
									"artifactRefs": {
										"$ref": "#/$defs/refs"
									},
									"dependsOn": {
										"$ref": "#/$defs/refs"
									},
									"evidenceRefs": {
										"$ref": "#/$defs/refs"
									},
									"status": {
										"enum": ["accepted", "conditional", "superseded"]
									},
									"details": {
										"type": "object",
										"additionalProperties": false,
										"required": [
											"responsibility",
											"consumers",
											"exchanges",
											"lifecycle",
											"failureBehavior",
											"decisionRefs"
										],
										"properties": {
											"responsibility": {
												"$ref": "#/$defs/text"
											},
											"consumers": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"exchanges": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"lifecycle": {
												"$ref": "#/$defs/text"
											},
											"failureBehavior": {
												"$ref": "#/$defs/text"
											},
											"decisionRefs": {
												"$ref": "#/$defs/refs"
											},
											"discussion": {
												"type": "array",
												"maxItems": 32,
												"items": {
													"$ref": "#/$defs/text"
												}
											}
										}
									}
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": [
									"id",
									"kind",
									"title",
									"summary",
									"owner",
									"scopeRefs",
									"productRefs",
									"artifactRefs",
									"dependsOn",
									"evidenceRefs",
									"status",
									"details"
								],
								"properties": {
									"id": {
										"$ref": "#/$defs/id"
									},
									"kind": {
										"const": "flow"
									},
									"title": {
										"$ref": "#/$defs/text"
									},
									"summary": {
										"$ref": "#/$defs/text"
									},
									"owner": {
										"$ref": "#/$defs/owner"
									},
									"scopeRefs": {
										"$ref": "#/$defs/refs"
									},
									"productRefs": {
										"$ref": "#/$defs/refs"
									},
									"artifactRefs": {
										"$ref": "#/$defs/refs"
									},
									"dependsOn": {
										"$ref": "#/$defs/refs"
									},
									"evidenceRefs": {
										"$ref": "#/$defs/refs"
									},
									"status": {
										"enum": ["accepted", "conditional", "superseded"]
									},
									"details": {
										"type": "object",
										"additionalProperties": false,
										"required": [
											"trigger",
											"preconditions",
											"steps",
											"success",
											"failure",
											"cancellation",
											"retry",
											"guarantees",
											"limits",
											"verification",
											"decisionRefs"
										],
										"properties": {
											"trigger": {
												"$ref": "#/$defs/text"
											},
											"preconditions": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"steps": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"type": "object",
													"additionalProperties": false,
													"required": ["ownerRef", "action", "result"],
													"properties": {
														"ownerRef": {
															"$ref": "#/$defs/id"
														},
														"action": {
															"$ref": "#/$defs/text"
														},
														"result": {
															"$ref": "#/$defs/text"
														}
													}
												}
											},
											"success": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"failure": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"cancellation": {
												"$ref": "#/$defs/text"
											},
											"retry": {
												"$ref": "#/$defs/text"
											},
											"guarantees": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"limits": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"verification": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"$ref": "#/$defs/text"
												}
											},
											"decisionRefs": {
												"$ref": "#/$defs/refs"
											},
											"discussion": {
												"type": "array",
												"maxItems": 32,
												"items": {
													"$ref": "#/$defs/text"
												}
											}
										}
									}
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": [
									"id",
									"kind",
									"title",
									"summary",
									"owner",
									"scopeRefs",
									"productRefs",
									"artifactRefs",
									"dependsOn",
									"evidenceRefs",
									"status",
									"details"
								],
								"properties": {
									"id": {
										"$ref": "#/$defs/id"
									},
									"kind": {
										"const": "decision"
									},
									"title": {
										"$ref": "#/$defs/text"
									},
									"summary": {
										"$ref": "#/$defs/text"
									},
									"owner": {
										"$ref": "#/$defs/owner"
									},
									"scopeRefs": {
										"$ref": "#/$defs/refs"
									},
									"productRefs": {
										"$ref": "#/$defs/refs"
									},
									"artifactRefs": {
										"$ref": "#/$defs/refs"
									},
									"dependsOn": {
										"$ref": "#/$defs/refs"
									},
									"evidenceRefs": {
										"$ref": "#/$defs/refs"
									},
									"status": {
										"enum": ["accepted", "proposed", "conditional", "superseded"]
									},
									"details": {
										"type": "object",
										"additionalProperties": false,
										"required": [
											"context",
											"choice",
											"alternatives",
											"consequences",
											"authority",
											"supersedes"
										],
										"properties": {
											"context": {
												"$ref": "#/$defs/text"
											},
											"choice": {
												"$ref": "#/$defs/text"
											},
											"alternatives": {
												"type": "array",
												"maxItems": 10000,
												"items": {
													"type": "object",
													"additionalProperties": false,
													"required": ["option", "disposition", "reason"],
													"properties": {
														"option": {
															"$ref": "#/$defs/text"
														},
														"disposition": {
															"enum": ["declined", "unselected"]
														},
														"reason": {
															"$ref": "#/$defs/text"
														}
													}
												}
											},
											"consequences": {
												"type": "array",
												"maxItems": 10000,
												"items": {
